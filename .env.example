# Public base URL used when generating session share links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Vercel Postgres connection string
# In local dev: copy these from your Vercel project's Storage tab
# On Vercel: these are set automatically when you link a Postgres database
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
