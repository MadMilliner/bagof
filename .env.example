# Vercel Postgres connection string (required)
# Get this from your Vercel project: Storage → Postgres → .env.local tab
# Or run: vercel env pull .env.local
POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# Optional: Vercel sets these automatically when you link a Postgres database
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
