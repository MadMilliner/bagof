# Local Postgres connection string for development/testing (recommended)
# Used automatically when running outside Vercel.
LOCAL_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/bagof_dev

# When LOCAL_POSTGRES_URL (or POSTGRES_URL_LOCAL) is set outside Vercel, absolute links on
# server-rendered pages (e.g. /internal-links) use this origin instead of NEXT_PUBLIC_BASE_URL.
# LOCAL_APP_URL=http://localhost:3000

# Canonical public origin in production (optional; falls back to request Host on Vercel).
# NEXT_PUBLIC_BASE_URL=https://your-deployment.vercel.app

# Production Postgres connection string (Vercel/Neon)
# Used in Vercel runtime and as fallback when no local URL is set.
POSTGRES_URL=postgres://user:password@host/database?sslmode=require

# Cron secret for session cleanup endpoint (required for production)
# Set this in Vercel: Settings → Environment Variables
# Vercel Cron automatically sends this as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=your-random-secret-here

# Optional: Vercel sets these automatically when you link a Postgres database
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=
